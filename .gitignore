<?php

$items = [
    '/vendor',
    '/node_modules',
    '/public/hot',
    '/storage/*.key',
    '/vendor/**',
    '/node_modules/**',
    '/.phpunit.result.cache',
    '/phpunit.xml',
    '/.env',
    '/.env.*',
    '/npm-debug.log',
    '/yarn-error.log',
    '/.DS_Store',
];

foreach ($items as $item) {
    echo $item . PHP_EOL;
}
